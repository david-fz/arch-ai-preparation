# Foundry (proyecto) con Entra ID
 LLM_BASE_URL=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>/openai/v1
 LLM_MODEL=<nombre-del-deployment>
 LLM_AUTH=entra

 # Ollama local (la api_key es obligatoria para el SDK pero Ollama la ignora)
 # LLM_BASE_URL=http://localhost:11434/v1
 # LLM_MODEL=llama3.2
 # LLM_API_KEY=ollama

 # Otro proveedor con API key (OpenRouter, OpenAI, vLLM...)
 # LLM_BASE_URL=https://openrouter.ai/api/v1
 # LLM_MODEL=<modelo>
 # LLM_API_KEY=<key>

 # Precios opcionales para cost_usd (USD por 1M de tokens)
 # LLM_PRICE_INPUT=0.15
 # LLM_PRICE_CACHED_INPUT=0.075
 # LLM_PRICE_OUTPUT=0.60